index fc57d90d9..df36720a2 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -456,6 +456,26 @@ config AMPERE_ERRATUM_AC04_CPU_23
 config ARM64_WORKAROUND_CLEAN_CACHE
 	bool
 
+config CUPID_FORCE_BUILTIN_DTB
+	bool "cupid: force use of built-in board DTB"
+	default n
+	help
+	  Xiaomi 12 (cupid) ABL only accepts vendor DTBs (it overlays the dtbo
+	  partition onto the image DTB; overlaying a mainline tree hangs or is
+	  silently rejected). The boot image therefore carries the stock vendor
+	  DTB blob purely as a decoy, and the kernel ignores the DTB ABL hands
+	  over, using the cupid DTB embedded via arch/arm64/kernel/cupid_dtb.S
+	  instead (see setup_arch).
+
+config CUPID_EARLY_FB
+	bool "cupid: early framebuffer console (draw kernel log on splash)"
+	default n
+	help
+	  Draw kernel messages directly onto the framebuffer the bootloader
+	  left scanning, from early_initcall until fbcon takes over. Ported
+	  from the Xiaomi 13 (fuxi) mainline port; enable with the kernel
+	  cmdline parameter cupid.fb=<phys>,<stride_px>,<height>,<width>,<bpp>.
+
 config ARM64_ERRATUM_826319
 	bool "Cortex-A53: 826319: System might deadlock if a write cannot complete until read data is accepted"
 	default y
