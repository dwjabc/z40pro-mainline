diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 23c05dc7a..692a481e6 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -289,6 +289,18 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_fixmap_init();
 	early_ioremap_init();
 
+	/*
+	 * cupid: ABL only processes vendor DTBs (it overlays the dtbo partition
+	 * onto the image DTB; overlaying a mainline tree kills the machine).
+	 * The boot image carries the stock vendor blob as a decoy; here we swap
+	 * in the mainline DTB compiled into the kernel (arch/arm64/kernel/cupid_dtb.S).
+	 */
+#if IS_ENABLED(CONFIG_CUPID_FORCE_BUILTIN_DTB)
+	{
+		extern const unsigned char cupid_dtb[];
+		__fdt_pointer = __pa_symbol((unsigned long)cupid_dtb);
+	}
+#endif
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
