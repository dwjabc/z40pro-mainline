# cupid (Xiaomi 12) 验证过的诱饵方案三件套
# cupid 方案: 内建 DTB 覆盖 ABL 传递 (诱饵机制)
CONFIG_Z40PRO_FORCE_BUILTIN_DTB=y
CONFIG_Z40PRO_EARLY_FB=y
# initramfs 编进内核 (boot.img 无 ramdisk)
CONFIG_INITRAMFS_SOURCE="../initramfs-builtin.cpio.gz"
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# cupid 实测: 开启会黑屏
# CONFIG_CPU_IDLE is not set

# Z40 Pro config fragment — 叠加在 defconfig 之上 (第一版: 全内建, 无模块)
# pstore/ramoops 崩溃日志
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y

# USB gadget 生命线 (initramfs NCM 网卡)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y

# 基础
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y

# Qualcomm 必备
CONFIG_QCOM_PDC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_QDF2400_ERRATUM_0065=y
CONFIG_REGULATOR_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SCM=y

# 面板 (M5)
CONFIG_DRM_PANEL_VISIONOX_RM692E5=y

# 调试
CONFIG_PRINTK_TIME=y
CONFIG_KASAN=n
CONFIG_SLUB_DEBUG=n
