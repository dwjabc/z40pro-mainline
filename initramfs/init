#!/bin/sh
# Z40 Pro mainline initramfs init v2 — 防御版
# 目标: 无论哪条路失败, 至少留下一个可交互通道 (ACM 串口 / NCM 网卡)
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /run /tmp /sys/kernel/config
mount -t configfs none /sys/kernel/config
mount -t pstore none /sys/fs/pstore 2>/dev/null

echo "=== Z40 Pro mainline initramfs v2 ==="
cat /proc/device-tree/model 2>/dev/null; echo
echo "--- pstore (上次 panic 日志, 如有) ---"
ls /sys/fs/pstore/ 2>/dev/null
cat /sys/fs/pstore/console-ramoops-0 2>/dev/null | tail -40
echo "--- dmesg tail ---"
dmesg | tail -25

# ---- USB gadget: 动态探测可用 function ----
CF=/sys/kernel/config/usb_gadget
if [ -d $CF ]; then
    G=$CF/g1
    mkdir -p $G 2>/dev/null
    echo 0x18d1 > $G/idVendor 2>/dev/null
    echo 0x4eee > $G/idProduct 2>/dev/null
    echo "z40pro-mainline" > $G/manufacturer 2>/dev/null
    mkdir -p $G/strings/0x409 2>/dev/null
    echo "z40pro-mainline" > $G/strings/0x409/product 2>/dev/null
    mkdir -p $G/configs/c.1 2>/dev/null
    echo 500 > $G/configs/c.1/MaxPower 2>/dev/null

    echo "--- 可用 USB functions ---"
    ls $CF/.functions 2>/dev/null || ls /sys/kernel/config/usb_gadget/__str 2>/dev/null
    FOUND=0
    mkdir -p $G/functions/ncm.usb0 2>/dev/null && { ln -sf $G/functions/ncm.usb0 $G/configs/c.1/f1; echo "[gadget] ncm OK"; FOUND=1; }
    if [ "$FOUND" = "0" ]; then
        mkdir -p $G/functions/ecm.usb0 2>/dev/null && { ln -sf $G/functions/ecm.usb0 $G/configs/c.1/f1; echo "[gadget] ecm OK (fallback)"; FOUND=1; }
    fi
    if [ "$FOUND" = "0" ]; then
        mkdir -p $G/functions/acm.usb1 2>/dev/null && { ln -sf $G/functions/acm.usb1 $G/configs/c.1/f1; echo "[gadget] 仅 acm (无网络)"; FOUND=1; }
    fi
    if [ "$FOUND" = "1" ]; then
        UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
        if [ -n "$UDC" ]; then
            echo "$UDC" > $G/UDC 2>/dev/null && echo "[gadget] bound $UDC" || echo "[gadget] UDC bind FAILED"
        else
            echo "[gadget] 无 UDC (dwc3 未就绪)"
        fi
    else
        echo "[gadget] 内核无任何 USB function 支持! (config 缺失)"
    fi
else
    echo "[gadget] configfs 不可用"
fi

# ---- 网络 ----
ifconfig usb0 192.168.237.2 netmask 255.255.255.0 up 2>/dev/null && \
    echo "[net] usb0=192.168.237.2"

# ---- 远程 shell ----
telnetd -b 0.0.0.0:23 2>/dev/null && echo "[dbg] telnetd :23"
mount -t debugfs none /sys/kernel/debug 2>/dev/null

echo "=== init done → console shell ==="
exec setsid cttyhack /bin/sh
