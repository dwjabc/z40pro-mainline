#!/bin/sh
# Z40 Pro mainline initramfs init v3 — 日志落盘通道 (logdump 分区)
# 机制: 内核起来第一时间把 dmesg 写入 UFS logdump 分区 (512MB 日志专用),
#       之后无论 gadget 成败, 都可用 EDL 读回日志精准定位。
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /run /tmp /dev/block /sys/kernel/config
mount -t configfs none /sys/kernel/config
mount -t pstore none /sys/fs/pstore 2>/dev/null

# ---- [最重要] 日志落盘: 找 512MB 的 logdump 分区写入 dmesg ----
# (gpt_full.txt: logdump=0x20000000B=524288KB, LUN4 唯一 512MB 分区)
LOGDONE=0
grep -E "sd[a-z]+|mmcblk" /proc/partitions > /tmp/parts.txt 2>/dev/null
# /proc/partitions: major minor #blocks name
while read MAJ MINOR BLKS NAME; do
    [ -z "$MAJ" ] && continue
    case "$NAME" in *loop*|*ram*|*zram*) continue;; esac
    if [ "$BLKS" = "524288" ]; then
        mknod /dev/logdump b "$MAJ" "$MINOR" 2>/dev/null
        dmesg > /tmp/kmsg.txt 2>/dev/null
        # 只写文件大小范围 (512B 块), 不动分区其余部分
        SZ=$(stat -c %s /tmp/kmsg.txt 2>/dev/null || wc -c < /tmp/kmsg.txt)
        N=$(( (SZ + 511) / 512 ))
        dd if=/tmp/kmsg.txt of=/dev/logdump bs=512 count=$N 2>/dev/null && LOGDONE=1
        echo "[logdump] wrote $SZ bytes ($N blocks) to $NAME ($MAJ:$MINOR)"
        break
    fi
done < /tmp/parts.txt
[ "$LOGDONE" = "1" ] || echo "[logdump] 未找到 512MB 分区 (partitions 见下)"
cat /proc/partitions
echo "--- pstore ---"; ls /sys/fs/pstore/ 2>/dev/null
cat /sys/fs/pstore/console-ramoops-0 2>/dev/null | tail -30

echo "=== Z40 Pro mainline initramfs v3 ==="
cat /proc/device-tree/model 2>/dev/null; echo

# ---- USB gadget (防御版) ----
CF=/sys/kernel/config/usb_gadget
if [ -d $CF ]; then
    G=$CF/g1
    mkdir -p $G 2>/dev/null
    echo 0x18d1 > $G/idVendor 2>/dev/null
    echo 0x4eee > $G/idProduct 2>/dev/null
    mkdir -p $G/strings/0x409 2>/dev/null
    echo "z40pro-mainline" > $G/strings/0x409/product 2>/dev/null
    mkdir -p $G/configs/c.1 2>/dev/null
    FOUND=0
    mkdir -p $G/functions/ncm.usb0 2>/dev/null && { ln -sf $G/functions/ncm.usb0 $G/configs/c.1/f1; echo "[gadget] ncm OK"; FOUND=1; }
    [ "$FOUND" = "0" ] && mkdir -p $G/functions/ecm.usb0 2>/dev/null && { ln -sf $G/functions/ecm.usb0 $G/configs/c.1/f1; echo "[gadget] ecm OK"; FOUND=1; }
    if [ "$FOUND" = "1" ]; then
        UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
        [ -n "$UDC" ] && { echo "$UDC" > $G/UDC 2>/dev/null && echo "[gadget] bound $UDC"; } || echo "[gadget] no UDC"
    else
        echo "[gadget] no USB function in kernel!"
    fi
fi
ifconfig usb0 192.168.237.2 netmask 255.255.255.0 up 2>/dev/null && echo "[net] up"
telnetd -b 0.0.0.0:23 2>/dev/null && echo "[dbg] telnetd"
mount -t debugfs none /sys/kernel/debug 2>/dev/null

echo "=== init v3 done ==="
exec setsid cttyhack /bin/sh
